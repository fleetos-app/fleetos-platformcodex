{
  "name": "fleetos-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "corepack pnpm -r --sort build",
    "dev": "corepack pnpm --filter @fleetos/web dev",
    "lint": "corepack pnpm -r --sort lint",
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r --sort typecheck",
    "clean": "corepack pnpm -r --sort clean"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
